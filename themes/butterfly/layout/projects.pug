extends ./base.pug

block headOpts
  - page.bodyClass = 'nova-tag-route nova-projects-route'
  - page.headOpts = { title: '工程 | Yibao', siteTitle: '工程', description: '软件学习记录：从安装配置到动手实践。', ogUrl: siteUrl + '/projects/', canonical: siteUrl + '/projects/', pageType: 'page', extraHead: (page.ldjson || '') + '<link rel="preload" as="image" href="/img/hero/projects-hero.webp" fetchpriority="high" type="image/webp">' }

block content
  != page.shellTop
  section.nova-tag-summary.nova-projects-summary(aria-label='工程概览')
    each cell, i in page.stats
      div
        strong= cell.value
        span= cell.en
        small= cell.zh
  section.nova-tags-index.nova-projects-index#nova-projects-index(aria-label='工程列表')
    header
      span PROJECT COLLECTION
      h2 工程列表
      p 按卡片浏览全部工程实践记录。
    //- 内联 grid: 3 列卡片布局不依赖外部 CSS 时序(首帧不单列堆叠)
    div.nova-projects-grid(style='display:grid;grid-template-columns:repeat(var(--cols,3),minmax(0,1fr));gap:var(--gap,28px 26px);')
      each p, i in page.projects
        article.nova-project-card
          a.nova-project-cover(href=p.detailHref aria-label='查看 ' + p.title + ' 的工程详情')
            //- 内联兜底: 3:2 占位, 不依赖外部 CSS 时序, 首帧不铺满
            span(style='display:block;padding-top:66.6667%;' aria-hidden='true')
            img(src=p.cover alt=p.title loading='lazy' decoding='async' style='position:absolute;inset:0;width:100%;height:100%;object-fit:cover;' onerror="this.onerror=null;this.src='/img/misc/404.jpg'")
          div.nova-project-body
            h3
              a(href=p.detailHref)= p.title
            div.nova-project-desc
              //- 三行截断; 不足三行时占位行沉底填充(卡片等高)
              p= p.description
              //- 阶段5 · 文案: 仅在描述确实为空时才渲染兜底行(此前对所有卡片无条件输出"陆续整理中",
              //- 虽被 .nova-project-desc 的 overflow 裁掉不显示, 但会写进 HTML 被爬虫读到)
              if !p.description
                span.nova-project-desc-placeholder(aria-hidden='true') 造物笔记，持续补完。
            div.nova-project-meta
              if p.date
                time(datetime=p.date)= p.date
              else
                span.nova-project-meta-live 持续更新中
              span.nova-project-meta-sep(aria-hidden='true') ·
              span= p.subtitle || p.category
            a.nova-project-action(href=p.detailHref aria-label='进入 ' + p.title + ' 的工程详情')
              span 进入项目
              span.nova-project-action-arrow(aria-hidden='true') →
  | </main>
  != page.shellBottom
